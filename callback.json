export default function handler(req, res) {
  const { code, state, error, error_description } = req.query;

  res.status(200).send(`
    <!DOCTYPE html>
    <html>
      <head>
        <meta charset="UTF-8">
        <title>TikTok OAuth</title>
      </head>
      <body>
        <h1>TikTok OAuth Callback</h1>
        <pre>${JSON.stringify({
          code,
          state,
          error,
          error_description
        }, null, 2)}</pre>
      </body>
    </html>
  `);
}